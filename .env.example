# Environment variables for OPHELIA Duty System

# Database connection (PostgreSQL - Supabase / Neon / Local PostgreSQL)
# Example Supabase pooled connection:
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Example Neon connection:
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT].neon.tech/neondb?sslmode=require"
# Example Local Postgres:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ophelia_duty?schema=public"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ophelia_duty?schema=public"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Discord OAuth2 Configuration (Optional for Dev/Demo Mode, Required for Production Discord Login)
DISCORD_CLIENT_ID="your_discord_client_id_here"
DISCORD_CLIENT_SECRET="your_discord_client_secret_here"
DISCORD_BOT_TOKEN="your_discord_bot_token_here"
DISCORD_GUILD_ID="your_discord_guild_id_here"
DISCORD_REDIRECT_URI="http://localhost:3000/api/auth/discord/callback"

# Session Secret (Random 32+ character string)
SESSION_SECRET="ophelia-duty-secret-key-super-secure-change-in-production-12345"

# Enable Dev Demo Switcher (true/false)
NEXT_PUBLIC_ENABLE_DEV_DEMO="true"
