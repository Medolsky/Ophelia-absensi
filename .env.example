# ================================================================
# OPHELIA Duty System — Environment Configuration Template
# ================================================================
# Salin file ini menjadi '.env' untuk lokal, atau masukkan key-value ini
# ke dalam menu: Vercel Dashboard -> Settings -> Environment Variables.

# 1. URL Domain Aplikasi
# Gunakan URL Vercel untuk Production, atau http://localhost:3000 untuk Lokal
NEXT_PUBLIC_APP_URL="https://ophelia-absensi.vercel.app"

# 2. Discord Developer Application Credentials
# Diperoleh dari https://discord.com/developers/applications
DISCORD_CLIENT_ID="your_discord_client_id_here"
DISCORD_CLIENT_SECRET="your_discord_client_secret_here"
DISCORD_BOT_TOKEN="your_discord_bot_token_here"
DISCORD_GUILD_ID="your_discord_guild_id_here"
DISCORD_REDIRECT_URI="https://ophelia-absensi.vercel.app/api/auth/discord/callback"

# 3. Kunci Enkripsi Cookie Sesi (String acak min. 32 karakter)
SESSION_SECRET="ophelia-duty-secret-key-super-secure-change-in-production-12345"

# 4. Mode Demo / Role Switcher (true untuk pengujian role, false jika sudah rilis penuh)
NEXT_PUBLIC_ENABLE_DEV_DEMO="true"

# 5. Database Connection (PostgreSQL - Neon / Supabase / Cloud Postgres)
# Opsional: Jika dikosongkan, sistem berjalan otomatis menggunakan High-Resilience In-Memory State.
# Contoh Neon:
# DATABASE_URL="postgresql://neondb_owner:npg_xxxx@ep-cool-fog-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Contoh Supabase:
# DATABASE_URL="postgresql://postgres.xxxx:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ophelia_duty?schema=public"
